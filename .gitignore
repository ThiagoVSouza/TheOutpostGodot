# Godot 4+ specific ignores
.godot/
.import/
export.cfg
# export_presets.cfg is deliberately TRACKED (Godot's template ignores it by default).
# Without it a fresh clone cannot export at all, and ours carries no secrets: signing uses the
# debug keystore from the *editor's* own settings, and the only credential-shaped keys
# (apk_expansion SALT / public_key) are empty. If a release keystore is ever configured here,
# move its path and password out to editor settings or an untracked override first.

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/tooling
.vs/
.vscode/
*.swp
*~

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Build/export output
build/
builds/
export/
*.pck
*.exe
*.app
*.dmg
*.apk

# Environment / secrets
.env
.env.local

# Node/JS leftovers (legacy Tauri app reference, if kept temporarily)
node_modules/
dist/
target/

# M6 GDExtension: build products plus the llama.cpp/CUDA runtime DLLs they need.
# ~1.1 GiB, and every byte of it is reproducible - `tools/setup_gdextension.ps1`
# rebuilds this folder from the pinned llama.cpp build and godot-cpp. The source
# that IS tracked is gdextension/src, gdextension/SConstruct and the
# .gdextension descriptor beside this folder.
/addons/outpost_llama/bin/
