#!/usr/bin/env python
# M6 GDExtension: binds libllama in-process (subprocess+HTTP cannot ship on
# mobile). See README.md for the full build recipe and the traps it cost.
#
# The two platforms get their llama.cpp differently, because upstream only
# publishes binaries for one of them:
#   windows - links the prebuilt b10042 release through import libs generated
#             from each DLL's export table (the release ships no .lib).
#   android - cross-compiled from source at the same pinned commit with the NDK,
#             since there is no prebuilt Android release to link against.
# Both are set up by tools/setup_gdextension.ps1.

env = SConscript("thirdparty/godot-cpp/SConstruct")

env.Append(CPPPATH=["src/"])
env.Append(CPPDEFINES=["LLAMA_SHARED"])

if env["platform"] == "android":
    llama_src = "thirdparty/llama.cpp-src"
    # Headers come from the source tree that produced these binaries, so they
    # cannot drift from it - llama.h describes a C ABI and a mismatched header
    # corrupts struct layouts silently rather than failing to compile.
    env.Append(CPPPATH=[llama_src + "/include", llama_src + "/ggml/include"])
    env.Append(LIBPATH=[llama_src + "/build-android/bin"])
    # 16 KB page alignment. Android 15+ devices can use 16 KB pages, and a
    # library whose LOAD segments are 4 KB-aligned is rejected there; Google
    # Play requires this of new uploads. The device surfaces it as a system
    # dialog listing every offending .so - which is how it was found. The
    # llama.cpp libraries get the same treatment via
    # ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES in tools/setup_gdextension.ps1.
    env.Append(LINKFLAGS=["-Wl,-z,max-page-size=16384"])
else:
    env.Append(CPPPATH=[
        "thirdparty/llama/include",
        "thirdparty/llama/include/ggml/include",
    ])
    env.Append(LIBPATH=["thirdparty/llama/lib"])

env.Append(LIBS=["llama", "ggml", "ggml-base"])

sources = Glob("src/*.cpp")

# Output straight into addons/ - the only place inside the Godot project (res://)
# that is allowed to hold build products. gdextension/ itself carries a
# .gdignore: its .obj files previously confused the editor's asset importer,
# which tried to reimport them as Wavefront OBJ meshes.
out_dir = "../addons/outpost_llama/bin/"
if env["platform"] == "windows":
    library = env.SharedLibrary(
        out_dir + "outpost_llama{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        out_dir + "liboutpost_llama{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

env.NoCache(library)
Default(library)
